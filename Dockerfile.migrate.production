# syntax=docker/dockerfile:1.7

FROM node:24.19.0-alpine3.23@sha256:244cc2b53f46f9e876304391d17682b0ddae9ac33491f4857e25e35a36ba7995 AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY deploy/migration/package.json ./deploy/migration/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @levi/production-migration... && \
    pnpm --filter @levi/production-migration deploy --prod /migrator

FROM node:24.19.0-alpine3.23@sha256:244cc2b53f46f9e876304391d17682b0ddae9ac33491f4857e25e35a36ba7995 AS migrator
ARG VCS_REF=unknown
ENV NODE_ENV=production
LABEL org.opencontainers.image.revision=$VCS_REF
WORKDIR /app
COPY --from=dependencies --chown=node:node /migrator/package.json ./package.json
COPY --from=dependencies --chown=node:node /migrator/node_modules ./node_modules
COPY --chown=node:node prisma/schema.prisma ./prisma/schema.prisma
COPY --chown=node:node prisma/migrations ./prisma/migrations
COPY --chown=node:node deploy/migration/prisma.config.ts ./prisma.config.ts
USER node
ENTRYPOINT ["node", "node_modules/prisma/build/index.js", "migrate", "deploy"]
