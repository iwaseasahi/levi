[Unit]
Description=Check Levi readiness, database, capacity, backups, 5xx, and container lifecycle
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/levi/monitoring.env
ExecStart=/opt/levi/scripts/run-production-health-monitor.sh
StateDirectory=levi-monitoring
StateDirectoryMode=0700
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
