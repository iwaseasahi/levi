LEVI_COMPOSE_FILE=/opt/levi/deploy/production/compose.yaml
LEVI_ENV_FILE=/etc/levi/production.env
LEVI_BACKUP_ROOT=/var/backups/levi
LEVI_BACKUP_CERTIFICATE=/etc/levi/backup-recipient.crt
LEVI_DATABASE_SERVICE=postgres
LEVI_DATABASE_NAME=levi
LEVI_DATABASE_USER=levi_admin
LEVI_BACKUP_CAPACITY_PERCENT=80
