LEVI_PRODUCTION_BASE_URL=https://levi-system.com
LEVI_COMPOSE_FILE=/opt/levi/deploy/production/compose.yaml
LEVI_ENV_FILE=/etc/levi/production.env
LEVI_BACKUP_ROOT=/var/backups/levi
LEVI_BACKUP_CAPACITY_PERCENT=80
LEVI_DISK_CAPACITY_PERCENT=80
LEVI_MEMORY_CAPACITY_PERCENT=90
LEVI_SLIDE_IMAGE_CAPACITY_PERCENT=80
LEVI_FIVE_XX_LIMIT=5
# Secret. Leave empty until a Slack Incoming Webhook is installed in the
# root-owned /etc/levi/monitoring.env file. Never commit the real URL.
LEVI_SLACK_WEBHOOK_URL=
