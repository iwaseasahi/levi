# Pass this file explicitly with Docker Compose's --env-file option.
LEVI_DOMAIN=levi.example.invalid
ACME_EMAIL=operator@example.invalid
LEVI_IMAGE=levi-production:local
LEVI_MIGRATION_IMAGE=levi-migration:local

# Runtime application settings. Replace every placeholder before production use.
NODE_ENV=production
DATABASE_URL=postgresql://levi_app:replace-with-a-distinct-app-password@postgres:5432/levi?schema=public
MIGRATION_DATABASE_URL=postgresql://levi_admin:replace-with-a-random-admin-password@postgres:5432/levi?schema=public
MIGRATION_SHADOW_DATABASE_URL=postgresql://levi_admin:replace-with-a-random-admin-password@postgres:5432/levi_shadow?schema=public
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_BASE_URL=https://levi.example.invalid
BETTER_AUTH_TRUSTED_ORIGINS=https://levi.example.invalid

# PostgreSQL initialization settings. The admin password must differ from the
# application password and is never injected into the application container.
POSTGRES_DB=levi
POSTGRES_USER=levi_admin
POSTGRES_PASSWORD=replace-with-a-random-admin-password
LEVI_APP_DATABASE_PASSWORD=replace-with-a-distinct-app-password
