# Pass this file explicitly with Docker Compose's --env-file option.
LEVI_DOMAIN=levi.example.invalid
ACME_EMAIL=operator@example.invalid

# Runtime application settings. Replace every placeholder before production use.
NODE_ENV=production
DATABASE_URL=postgresql://levi:replace-with-a-random-password@postgres:5432/levi?schema=public
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_BASE_URL=https://levi.example.invalid
BETTER_AUTH_TRUSTED_ORIGINS=https://levi.example.invalid

# PostgreSQL initialization settings. Keep the password identical to DATABASE_URL.
POSTGRES_DB=levi
POSTGRES_USER=levi
POSTGRES_PASSWORD=replace-with-a-random-password
