# Local development database created by `pnpm db:up`.
DATABASE_URL=postgresql://levi:levi@127.0.0.1:55432/levi?schema=public

# Prisma uses an isolated database to replay migration history and detect drift.
SHADOW_DATABASE_URL=postgresql://levi:levi@127.0.0.1:55432/levi_shadow?schema=public

# Synthetic local-only Better Auth configuration. Production values are created
# and injected only through an explicitly approved secret operation.
BETTER_AUTH_SECRET=local-only-not-a-production-secret-0000000000
ADMIN_BETTER_AUTH_SECRET=local-admin-only-not-a-production-secret-000000
BETTER_AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1125
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=levi-system@localhost.test

# Administration uses separate HTTP Basic authentication. Generate the scrypt
# verifier with `pnpm admin:hash-password`; never place the plaintext here.
ADMIN_BASIC_AUTH_USERNAME=levi-admin
ADMIN_BASIC_AUTH_PASSWORD_HASH=replace-with-output-from-admin-hash-password
