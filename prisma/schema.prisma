generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserActorState {
  PENDING
  ACTIVE

  @@map("user_actor_state")
}

enum ChurchStatus {
  ACTIVE
  SUSPENDED

  @@map("church_status")
}

enum BibleTestament {
  OLD
  NEW

  @@map("bible_testament")
}

model User {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String            @db.VarChar(200)
  email              String            @unique(map: "users_email_uk") @db.Citext
  emailVerified      Boolean           @default(false) @map("email_verified")
  image              String?           @db.Text
  actorState         UserActorState    @default(PENDING) @map("actor_state")
  mustChangePassword Boolean           @default(false) @map("must_change_password")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  accounts           Account[]
  sessions           Session[]
  platformOperator   PlatformOperator?
  churchMembership   ChurchMembership?

  @@map("users")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  issuer                String    @db.VarChar(255)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @db.Text
  idToken               String?   @map("id_token") @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "accounts_user_fk")

  @@unique([issuer, accountId], map: "accounts_issuer_account_uk")
  @@unique([userId, providerId], map: "accounts_user_provider_uk")
  @@map("accounts")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique(map: "sessions_token_uk") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sessions_user_fk")

  @@index([userId, expiresAt(sort: Desc)], map: "sessions_user_expires_idx")
  @@index([expiresAt], map: "sessions_expires_idx")
  @@map("sessions")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier], map: "verifications_identifier_idx")
  @@index([expiresAt], map: "verifications_expires_idx")
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique(map: "rate_limits_key_uk") @db.VarChar(255)
  count       Int
  lastRequest BigInt @map("last_request")

  @@index([lastRequest], map: "rate_limits_last_request_idx")
  @@map("rate_limits")
}

model Church {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @db.VarChar(200)
  status      ChurchStatus      @default(ACTIVE)
  suspendedAt DateTime?         @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership  ChurchMembership?
  folders     Folder[]

  @@map("churches")
}

model PlatformOperator {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "platform_operators_user_fk")

  @@map("platform_operators")
}

model ChurchMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId  String   @unique(map: "church_memberships_church_uk") @map("church_id") @db.Uuid
  userId    String   @unique(map: "church_memberships_user_uk") @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "church_memberships_church_fk")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "church_memberships_user_fk")

  @@map("church_memberships")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("system_settings")
}

model BibleTranslation {
  id                          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                        String              @unique(map: "bible_translations_code_uk") @db.VarChar(16)
  name                        String              @db.VarChar(200)
  languageTag                 String              @map("language_tag") @db.VarChar(35)
  displayOrder                Int                 @unique(map: "bible_translations_display_order_uk") @map("display_order") @db.SmallInt
  sourceReference             String?             @map("source_reference") @db.Text
  rightsNotice                String?             @map("rights_notice") @db.Text
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookNames                   BibleBookName[]
  verses                      BibleVerse[]
  primaryScriptureBookmarks   ScriptureBookmark[] @relation("ScriptureBookmarkPrimaryTranslation")
  secondaryScriptureBookmarks ScriptureBookmark[] @relation("ScriptureBookmarkSecondaryTranslation")

  @@map("bible_translations")
}

model BibleBook {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonicalCode      String              @unique(map: "bible_books_canonical_code_uk") @map("canonical_code") @db.VarChar(16)
  canonicalOrder     Int                 @unique(map: "bible_books_canonical_order_uk") @map("canonical_order") @db.SmallInt
  testament          BibleTestament
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  names              BibleBookName[]
  verses             BibleVerse[]
  scriptureBookmarks ScriptureBookmark[]

  @@map("bible_books")
}

model BibleBookName {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  translationId String           @map("translation_id") @db.Uuid
  bookId        String           @map("book_id") @db.Uuid
  name          String           @db.VarChar(100)
  shortName     String?          @map("short_name") @db.VarChar(40)
  translation   BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bible_book_names_translation_fk")
  book          BibleBook        @relation(fields: [bookId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bible_book_names_book_fk")

  @@unique([translationId, bookId], map: "bible_book_names_translation_book_uk")
  @@unique([translationId, name], map: "bible_book_names_translation_name_uk")
  @@map("bible_book_names")
}

model BibleVerse {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  translationId           String              @map("translation_id") @db.Uuid
  bookId                  String              @map("book_id") @db.Uuid
  chapterNumber           Int                 @map("chapter_number") @db.SmallInt
  verseNumber             Int                 @map("verse_number") @db.SmallInt
  text                    String              @db.Text
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  translation             BibleTranslation    @relation(fields: [translationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bible_verses_translation_fk")
  book                    BibleBook           @relation(fields: [bookId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bible_verses_book_fk")
  primaryStartBookmarks   ScriptureBookmark[] @relation("ScriptureBookmarkPrimaryStart")
  primaryEndBookmarks     ScriptureBookmark[] @relation("ScriptureBookmarkPrimaryEnd")
  secondaryStartBookmarks ScriptureBookmark[] @relation("ScriptureBookmarkSecondaryStart")
  secondaryEndBookmarks   ScriptureBookmark[] @relation("ScriptureBookmarkSecondaryEnd")

  @@unique([translationId, bookId, chapterNumber, verseNumber], map: "bible_verses_location_uk")
  @@index([bookId, chapterNumber, verseNumber, translationId], map: "bible_verses_navigation_idx")
  @@map("bible_verses")
}

model Folder {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId   String     @map("church_id") @db.Uuid
  name       String     @db.VarChar(200)
  isPinned   Boolean    @default(false) @map("is_pinned")
  position   Int
  lastUsedAt DateTime?  @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  church     Church     @relation(fields: [churchId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "folders_church_fk")
  bookmarks  Bookmark[]

  @@unique([id, churchId], map: "folders_id_church_uk")
  @@unique([churchId, position], map: "folders_church_position_uk")
  @@index([churchId, isPinned(sort: Desc), position, id], map: "folders_pinned_idx")
  @@index([churchId, lastUsedAt(sort: Desc), position, id], map: "folders_recent_idx")
  @@map("folders")
}

model Bookmark {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId  String             @map("church_id") @db.Uuid
  folderId  String             @map("folder_id") @db.Uuid
  title     String             @db.VarChar(200)
  position  Int
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  folder    Folder             @relation(fields: [folderId, churchId], references: [id, churchId], onDelete: Cascade, onUpdate: NoAction, map: "bookmarks_folder_church_fk")
  scripture ScriptureBookmark?

  @@unique([folderId, position], map: "bookmarks_folder_position_uk")
  @@index([churchId, folderId, position, id], map: "bookmarks_church_folder_position_idx")
  @@map("bookmarks")
}

model ScriptureBookmark {
  bookmarkId             String            @id @map("bookmark_id") @db.Uuid
  bookId                 String            @map("book_id") @db.Uuid
  chapterNumber          Int               @map("chapter_number") @db.SmallInt
  startVerse             Int               @map("start_verse") @db.SmallInt
  endVerse               Int               @map("end_verse") @db.SmallInt
  primaryTranslationId   String            @map("primary_translation_id") @db.Uuid
  secondaryTranslationId String?           @map("secondary_translation_id") @db.Uuid
  bookmark               Bookmark          @relation(fields: [bookmarkId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "scripture_bookmarks_bookmark_fk")
  book                   BibleBook         @relation(fields: [bookId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "scripture_bookmarks_book_fk")
  primaryTranslation     BibleTranslation  @relation("ScriptureBookmarkPrimaryTranslation", fields: [primaryTranslationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "scripture_bookmarks_primary_translation_fk")
  secondaryTranslation   BibleTranslation? @relation("ScriptureBookmarkSecondaryTranslation", fields: [secondaryTranslationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "scripture_bookmarks_secondary_translation_fk")
  primaryStartVerse      BibleVerse        @relation("ScriptureBookmarkPrimaryStart", fields: [primaryTranslationId, bookId, chapterNumber, startVerse], references: [translationId, bookId, chapterNumber, verseNumber], onDelete: Restrict, onUpdate: NoAction, map: "scripture_bookmarks_primary_start_fk")
  primaryEndVerse        BibleVerse        @relation("ScriptureBookmarkPrimaryEnd", fields: [primaryTranslationId, bookId, chapterNumber, endVerse], references: [translationId, bookId, chapterNumber, verseNumber], onDelete: Restrict, onUpdate: NoAction, map: "scripture_bookmarks_primary_end_fk")
  secondaryStartVerse    BibleVerse?       @relation("ScriptureBookmarkSecondaryStart", fields: [secondaryTranslationId, bookId, chapterNumber, startVerse], references: [translationId, bookId, chapterNumber, verseNumber], onDelete: Restrict, onUpdate: NoAction, map: "scripture_bookmarks_secondary_start_fk")
  secondaryEndVerse      BibleVerse?       @relation("ScriptureBookmarkSecondaryEnd", fields: [secondaryTranslationId, bookId, chapterNumber, endVerse], references: [translationId, bookId, chapterNumber, verseNumber], onDelete: Restrict, onUpdate: NoAction, map: "scripture_bookmarks_secondary_end_fk")

  @@map("scripture_bookmarks")
}
