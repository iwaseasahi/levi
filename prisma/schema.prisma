generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserActorState {
  PENDING
  ACTIVE

  @@map("user_actor_state")
}

enum ChurchStatus {
  ACTIVE
  SUSPENDED

  @@map("church_status")
}

model User {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String            @db.VarChar(200)
  email              String            @unique(map: "users_email_uk") @db.Citext
  emailVerified      Boolean           @default(false) @map("email_verified")
  image              String?           @db.Text
  actorState         UserActorState    @default(PENDING) @map("actor_state")
  mustChangePassword Boolean           @default(false) @map("must_change_password")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  accounts           Account[]
  sessions           Session[]
  platformOperator   PlatformOperator?
  churchMembership   ChurchMembership?

  @@map("users")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  issuer                String    @db.VarChar(255)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @db.Text
  idToken               String?   @map("id_token") @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "accounts_user_fk")

  @@unique([issuer, accountId], map: "accounts_issuer_account_uk")
  @@unique([userId, providerId], map: "accounts_user_provider_uk")
  @@map("accounts")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique(map: "sessions_token_uk") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sessions_user_fk")

  @@index([userId, expiresAt(sort: Desc)], map: "sessions_user_expires_idx")
  @@index([expiresAt], map: "sessions_expires_idx")
  @@map("sessions")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier], map: "verifications_identifier_idx")
  @@index([expiresAt], map: "verifications_expires_idx")
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique(map: "rate_limits_key_uk") @db.VarChar(255)
  count       Int
  lastRequest BigInt @map("last_request")

  @@index([lastRequest], map: "rate_limits_last_request_idx")
  @@map("rate_limits")
}

model Church {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @db.VarChar(200)
  status      ChurchStatus      @default(ACTIVE)
  suspendedAt DateTime?         @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership  ChurchMembership?

  @@map("churches")
}

model PlatformOperator {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "platform_operators_user_fk")

  @@map("platform_operators")
}

model ChurchMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  churchId  String   @unique(map: "church_memberships_church_uk") @map("church_id") @db.Uuid
  userId    String   @unique(map: "church_memberships_user_uk") @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "church_memberships_church_fk")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "church_memberships_user_fk")

  @@map("church_memberships")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("system_settings")
}
