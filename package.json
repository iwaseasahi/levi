{
  "name": "levi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait postgres postgres-test",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/reset-database.ts",
    "db:schema:check": "prisma validate && prisma format --check && prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:check": "pnpm db:migrate && pnpm db:schema:check && pnpm db:seed && tsx scripts/verify-database.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.19.0"
}
