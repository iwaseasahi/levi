{
  "name": "levi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "BETTER_AUTH_SECRET=build-only-secret-at-least-thirty-two-characters ADMIN_BETTER_AUTH_SECRET=build-only-admin-secret-at-least-thirty-two-characters BETTER_AUTH_BASE_URL=https://levi.invalid BETTER_AUTH_TRUSTED_ORIGINS=https://levi.invalid SLIDE_IMAGE_BYTES_PER_CHURCH=1073741824 next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:up": "docker compose --file compose.development.yaml up -d --wait mailpit postgres postgres-test",
    "db:up:dev": "docker compose --file compose.development.yaml up -d --wait mailpit postgres",
    "db:up:test": "docker compose --file compose.development.yaml up -d --wait postgres-test",
    "db:up:e2e": "docker compose --file compose.development.yaml up -d --wait mailpit-e2e postgres-test",
    "db:clean:e2e": "docker compose --file compose.development.yaml rm --stop --force mailpit-e2e",
    "db:down": "docker compose --file compose.development.yaml down",
    "db:stop:dev": "docker compose --file compose.development.yaml stop mailpit postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/reset-database.ts",
    "db:schema:check": "prisma validate && prisma format --check && prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:check": "prisma generate && pnpm db:migrate && pnpm db:schema:check && pnpm db:seed && tsx scripts/verify-database.ts",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "DATABASE_URL=postgresql://localhost/levi SHADOW_DATABASE_URL=postgresql://localhost/levi_shadow prisma generate && DATABASE_URL=postgresql://localhost/levi SHADOW_DATABASE_URL=postgresql://localhost/levi_shadow vitest run --config vitest.config.ts --coverage",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "test:e2e:install": "playwright install chromium",
    "security:audit": "tsx scripts/check-vulnerabilities.ts",
    "security:licenses": "tsx scripts/check-licenses.ts",
    "security:check": "pnpm security:audit && pnpm security:licenses",
    "admin:hash-password": "tsx scripts/hash-admin-password.ts",
    "backup:rehearse": "bash scripts/rehearse-backup.sh",
    "backup:config:check": "tsx scripts/check-backup-configuration.ts",
    "deployment:config:check": "tsx scripts/check-deployment-configuration.ts",
    "monitoring:config:check": "tsx scripts/check-monitoring-configuration.ts",
    "production:release:prepare": "bash scripts/prepare-production-release.sh",
    "production:release:deploy": "bash scripts/deploy-production-release.sh",
    "production:deploy:authorized": "bash scripts/run-authorized-production-deploy.sh",
    "production:domain:check": "tsx scripts/check-production-domain.ts",
    "production:domain:verify": "tsx scripts/check-production-domain.ts --live",
    "production:config:check": "tsx scripts/check-production-compose.ts",
    "production:rehearse": "bash scripts/rehearse-production-compose.sh",
    "readiness:check": "tsx scripts/check-readiness.ts",
    "local:env:prepare": "tsx scripts/prepare-local-env.ts",
    "local:smoke": "tsx scripts/check-local-app.ts",
    "local:config:check": "tsx scripts/check-local-development.ts",
    "release:checklist:dry-run": "tsx scripts/check-release-plan.ts",
    "migration:profile:ginmaku": "tsx scripts/profile-ginmaku-dump.ts",
    "migration:bible": "tsx scripts/import-ginmaku-bible.ts",
    "migration:bible:rehearse": "tsx scripts/rehearse-ginmaku-bible.ts",
    "agent:checkpoint": "tsx scripts/agent-handoff.ts checkpoint",
    "agent:checkpoint:verify": "tsx scripts/agent-handoff.ts verify",
    "agent:lease": "tsx scripts/agent-handoff.ts lease",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm local:config:check && pnpm production:domain:check && pnpm production:config:check && pnpm backup:config:check && pnpm deployment:config:check && pnpm monitoring:config:check && pnpm build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-bullet-list": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-history": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-list-item": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "better-auth": "1.7.2",
    "next": "16.3.3",
    "nodemailer": "9.0.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "^6",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
