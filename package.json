{
  "name": "levi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait postgres postgres-test",
    "db:up:dev": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:stop:dev": "docker compose stop postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/reset-database.ts",
    "db:schema:check": "prisma validate && prisma format --check && prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:check": "prisma generate && pnpm db:migrate && pnpm db:schema:check && pnpm db:seed && tsx scripts/verify-database.ts",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "test:e2e:install": "playwright install chromium",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:licenses": "tsx scripts/check-licenses.ts",
    "security:check": "pnpm security:audit && pnpm security:licenses",
    "backup:rehearse": "bash scripts/rehearse-backup.sh",
    "backup:config:check": "tsx scripts/check-backup-configuration.ts",
    "deployment:config:check": "tsx scripts/check-deployment-configuration.ts",
    "production:config:check": "tsx scripts/check-production-compose.ts",
    "production:rehearse": "bash scripts/rehearse-production-compose.sh",
    "readiness:check": "tsx scripts/check-readiness.ts",
    "local:env:prepare": "tsx scripts/prepare-local-env.ts",
    "local:smoke": "tsx scripts/check-local-app.ts",
    "local:config:check": "tsx scripts/check-local-development.ts",
    "release:checklist:dry-run": "tsx scripts/check-release-plan.ts",
    "migration:profile:ginmaku": "tsx scripts/profile-ginmaku-dump.ts",
    "migration:bible": "tsx scripts/import-ginmaku-bible.ts",
    "migration:bible:rehearse": "tsx scripts/rehearse-ginmaku-bible.ts",
    "agent:checkpoint": "tsx scripts/agent-handoff.ts checkpoint",
    "agent:checkpoint:verify": "tsx scripts/agent-handoff.ts verify",
    "agent:lease": "tsx scripts/agent-handoff.ts lease",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm local:config:check && pnpm production:config:check && pnpm backup:config:check && pnpm deployment:config:check && pnpm build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.7.1",
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
